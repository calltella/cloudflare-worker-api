# API server only. Set these in .env.local or the deployed Worker environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# For older projects, SUPABASE_ANON_KEY can replace the publishable key.
# No Supabase service-role/secret key is required by this API.
